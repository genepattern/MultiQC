# GenePattern Module Manifest

LSID=urn:lsid:broad.mit.edu:cancer.software.genepattern.module.generated:35002:3
name=MultiQC
version=3
author=GenePattern Team
description=MultiQC is a tool to create a single interactive HTML report aggregating quality control metrics from multiple bioinformatics analyses across many samples. It automatically discovers and parses output files from 171+ supported tools (FastQC, STAR, HISAT2, Salmon, Picard, Samtools, and more) and produces a unified report enabling rapid cross-sample and cross-step quality assessment. The module accepts a ZIP archive of tool output files, runs MultiQC, and returns an interactive HTML report along with structured data files.
categories=QC;RNA-seq;WGS;Reporting;Preprocessing
commandLine=python <libdir>multiqc_wrapper.py --input.data <input.data> <report.title> <report.comment> <output.filename> <modules> <exclude.modules> <data.format> <flat.plots> <export.plots> <prepend.dirs> <sample.names.file> <config.file> <extra.config>
cpuType=any
os=any
language=Python
fileFormat=zip;txt;tsv;yaml
taskType=Preprocessing
taskDoc=README.md
documentationUrl=https://docs.seqera.io/multiqc/
quality=production
privacy=public
job.cpuCount=1
job.memory=2Gb
job.docker.image=genepattern/multiqc\:1
src.repo=https://github.com/MultiQC/MultiQC

# Parameters
p1_MODE=IN
p1_TYPE=FILE
p1_description=A ZIP archive containing output files from one or more supported bioinformatics tools (e.g., FastQC, STAR, Salmon, Picard, Samtools). MultiQC will automatically detect and parse all recognized file types within the archive. Supported tool outputs include FastQC ZIP archives, STAR Log.final.out files, Samtools flagstat/stats, Picard metrics files, featureCounts summaries, Salmon/Kallisto run logs, and many more.
p1_fileFormat=zip;txt;tsv;yaml
p1_name=input.data
p1_numValues=1..1
p1_optional=
p1_type=java.io.File
p2_TYPE=TEXT
p2_description=Title to display at the top of the HTML report. Useful for labeling the experiment or project (e.g., 'RNA-seq QC - Project ABC'). If not provided, a generic title is used.
p2_name=report.title
p2_numValues=0..1
p2_optional=on
p2_prefix_when_specified=--report.title 
p2_type=java.lang.String
p3_TYPE=TEXT
p3_description=A custom comment or note to include at the top of the report. Useful for adding experiment context, project IDs, or analysis notes (e.g., 'Sequenced on Illumina NovaSeq 6000, 2x150 bp paired-end').
p3_name=report.comment
p3_numValues=0..1
p3_optional=on
p3_prefix_when_specified=--report.comment 
p3_type=java.lang.String
p4_TYPE=TEXT
p4_default_value=multiqc_report.html
p4_description=Filename for the output HTML report. Default is multiqc_report.html. Provide only the filename (no directory path). The .html extension is recommended.
p4_name=output.filename
p4_numValues=0..1
p4_optional=on
p4_prefix_when_specified=--output.filename 
p4_type=java.lang.String
p5_TYPE=TEXT
p5_description=Comma-separated list of MultiQC module names to include in the report (e.g., 'fastqc,star,salmon'). If not specified, all detected modules will be run. Use this to limit the report to specific tools when you know which tools generated your input data. Common values: fastqc, fastp, star, hisat2, salmon, kallisto, samtools, picard, qualimap, featurecounts, bismark, kraken2.
p5_name=modules
p5_numValues=0..1
p5_optional=on
p5_prefix_when_specified=--modules 
p5_type=java.lang.String
p6_TYPE=TEXT
p6_description=Comma-separated list of MultiQC module names to exclude from the report (e.g., 'fastqc,star'). Use this to suppress specific tool sections from the final report.
p6_name=exclude.modules
p6_numValues=0..1
p6_optional=on
p6_prefix_when_specified=--exclude.modules 
p6_type=java.lang.String
p7_TYPE=TEXT
p7_default_value=tsv
p7_description=Output format for the structured data files in the multiqc_data directory. These files contain the parsed numerical metrics from all detected tools and can be used for downstream programmatic analysis.
p7_name=data.format
p7_numValues=0..1
p7_optional=on
p7_prefix_when_specified=--data.format 
p7_type=java.lang.String
p7_value=tsv\=TSV (tab-separated values);json\=JSON;yaml\=YAML
p8_TYPE=TEXT
p8_default_value=false
p8_description=Generate flat (static, non-interactive) plots instead of the default interactive JavaScript-based Plotly plots. Recommended for very large cohorts (500+ samples) where interactive plots may be slow to load in a browser, or when a simpler report is preferred.
p8_name=flat.plots
p8_numValues=0..1
p8_optional=on
p8_prefix_when_specified=--flat.plots 
p8_type=java.lang.String
p8_value=false\=Interactive plots (default);true\=Flat/static plots
p9_TYPE=TEXT
p9_default_value=false
p9_description=Export all report plots as static image files (PNG, SVG, and PDF formats) alongside the HTML report. Output images are placed in a multiqc_plots subdirectory. Useful for publication figures or presentations.
p9_name=export.plots
p9_numValues=0..1
p9_optional=on
p9_prefix_when_specified=--export.plots 
p9_type=java.lang.String
p9_value=false\=Do not export plot images (default);true\=Export plot images (PNG/SVG/PDF)
p10_TYPE=TEXT
p10_default_value=false
p10_description=Prepend the parent directory name to sample names in the report. Useful for disambiguating identically named samples from different analysis steps, batches, or runs that may otherwise appear with the same name.
p10_name=prepend.dirs
p10_numValues=0..1
p10_optional=on
p10_prefix_when_specified=--prepend.dirs 
p10_type=java.lang.String
p10_value=false\=Do not prepend directory names (default);true\=Prepend directory names to sample names
p11_MODE=IN
p11_TYPE=FILE
p11_description=A tab-separated (TSV) file mapping original sample names (as detected by MultiQC) to custom display names. The file should have two columns with headers: 'Sample Name' and 'Display Name'. Useful for converting cryptic SRR accession numbers or internal identifiers to meaningful, human-readable sample labels in the report.
p11_fileFormat=tsv;txt
p11_name=sample.names.file
p11_numValues=0..1
p11_optional=on
p11_prefix_when_specified=--sample.names.file 
p11_type=java.io.File
p12_MODE=IN
p12_TYPE=FILE
p12_description=Path to a custom MultiQC YAML configuration file (typically named multiqc_config.yaml). Allows advanced customization of report appearance, module order, report header information (contact, sequencer, date), color schemes, ignored file patterns, table column visibility, and many other settings. See the MultiQC documentation for full configuration reference.
p12_fileFormat=yaml;yml
p12_name=config.file
p12_numValues=0..1
p12_optional=on
p12_prefix_when_specified=--config.file 
p12_type=java.io.File
p13_TYPE=TEXT
p13_description=Inline YAML configuration string passed directly to MultiQC (equivalent to the --cl-config flag). Useful for quick, per-run customizations without creating a full configuration file. Example: 'report_header_info: [{Contact: name@example.com, Application: RNA-seq}]'. This is merged with any configuration provided in the config.file parameter.
p13_name=extra.config
p13_numValues=0..1
p13_optional=on
p13_prefix_when_specified=--extra.config 
p13_type=java.lang.String
